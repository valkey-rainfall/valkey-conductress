# Add this in the nginx http {} block:
limit_req_zone $binary_remote_addr zone=conductress_api:10m rate=10r/s;

# Add this location inside the existing TLS-enabled data.conductress server {} block.
# Bearer authentication is enforced by the application.
location /api/v1/ {
    limit_req zone=conductress_api burst=20 nodelay;
    # Must be >= the app's MAX_BODY_BYTES (default 4 MiB, see
    # control/config.py). A completed task's outcome is the largest body a
    # runner sends. When nginx is the lower limit it answers 413 with no JSON
    # body, so the runner sees HTTP_413 instead of the app's BODY_TOO_LARGE
    # and cannot tell a size problem from a proxy fault. Check the deployed
    # app value with GET /api/v1/health (limits.max_body_bytes).
    client_max_body_size 4m;
    proxy_pass http://127.0.0.1:8390;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
}
